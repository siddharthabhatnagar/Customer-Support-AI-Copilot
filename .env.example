# Customer Support AI Copilot Environment Configuration
# Get your Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Get your NVIDIA NIM API key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here

# LLM & Embedding Models
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Server Port
PORT=8000
